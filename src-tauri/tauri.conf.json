{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "herdr Config",
  "version": "0.1.0",
  "identifier": "dev.herdr.config-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "herdr Config",
        "width": 1180,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
