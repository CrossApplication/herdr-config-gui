// Slint rendering of the current UI, for comparison with the Tauri build.
// The palette is the shipping app's CSS custom properties, verbatim.

import { Button, LineEdit, CheckBox, ComboBox, ScrollView, AboutSlint } from "std-widgets.slint";

export global Palette {
    out property <color> bg: #11111b;
    out property <color> panel: #181825;
    out property <color> row: #1e1e2e;
    out property <color> line: #313244;
    out property <color> text: #cdd6f4;
    out property <color> dim: #7f849c;
    out property <color> faint: #45475a;
    out property <color> accent: #89b4fa;
    out property <color> set: #a6e3a1;
    out property <color> warn: #f9e2af;
    out property <color> red: #f38ba8;
}

export struct SectionRow {
    name: string,
    total: int,
    set-count: int,
}

export struct TokenCell {
    token: string,
    fg: color,
    has-fg: bool,
    bold: bool,
    dim: bool,
}

export struct RowEntry {
    tokens: [TokenCell],
    preview: string,
}

export struct DiffRow {
    // `add` | `update` | `remove`
    action: string,
    path: string,
    from: string,
    to: string,
}

export struct ProblemEntry {
    path: string,
    value: string,
    state: string,
}

export struct ProblemRow {
    // `構文エラー` / `キー衝突` / `端末依存`
    label: string,
    severity: string,
    chord: string,
    detail: string,
    advice: string,
    scope: string,
    entries: [ProblemEntry],
}

export struct ItemRow {
    path: string,
    key: string,
    doc: string,
    // "text" | "bool" | "int" | "color"
    kind: string,
    // Current value as display text; empty means inheriting the default.
    value: string,
    default-text: string,
    is-set: bool,
    is-dirty: bool,
    swatch: color,
    has-swatch: bool,
    // Only populated when kind == "rows".
    rows: [RowEntry],
    is-binding: bool,
    /// The key on its own, or the dotted path while filtering.
    label: string,
    /// `既定` / `設定済み` / `無効` / `未保存`.
    state-label: string,
    /// Members herdr accepts. Only populated when they are the real set;
    /// literals scraped from prose are left to the documentation line, which
    /// already spells them out.
    enum-values: [string],
    enum-strict: bool,
    /// Contributed by the overlay, not by `herdr --default-config`.
    from-overlay: bool,
    /// A popup dimension: a percentage string or a bare cell count.
    is-size: bool,
    /// Terminal-reliability note for a binding, and its level.
    key-note: string,
    key-level: string,
    /// True when herdr documents `""` as this setting's off switch.
    empty-disables: bool,
}

export struct EntryCard {
    index: int,
    label: string,
    items: [ItemRow],
}

// A chip: the three-state marker from the shipping UI.
component Chip inherits Rectangle {
    in property <string> label;
    in property <color> tone: Palette.dim;
    border-color: tone;
    border-width: 1px;
    border-radius: 9px;
    height: 18px;
    width: 64px;
    Text {
        text: label;
        color: tone;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// For a secondary action that should not compete with the buttons beside it.
component TextLink inherits Rectangle {
    in property <string> label;
    in property <color> tone: Palette.dim;
    callback clicked();

    width: txt.preferred-width;
    height: 28px;
    txt := Text {
        text: root.label;
        color: touch.has-hover ? Palette.accent : root.tone;
        font-size: 12px;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height / 2 + 9px;
        height: 1px;
        background: touch.has-hover ? Palette.accent : transparent;
    }
    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

component GhostButton inherits Rectangle {
    in property <string> label;
    in property <color> tone: Palette.dim;
    /// Filled rather than outlined, for the one action a bar is about.
    in property <bool> filled: false;
    /// A disabled button says the action is unavailable, which is how the bar
    /// reports "nothing to save" without a label saying so.
    in property <bool> enabled: true;
    callback clicked();

    opacity: enabled ? 1.0 : 0.35;
    background: filled
        ? (touch.has-hover && enabled ? tone.brighter(0.2) : tone)
        : (touch.has-hover && enabled ? #ffffff0d : transparent);
    border-color: filled ? tone : (touch.has-hover && enabled ? tone : Palette.line);
    border-width: 1px;
    border-radius: 6px;
    height: 28px;
    width: txt.preferred-width + 24px;
    Text {
        x: 12px;
        text: root.label;
        color: root.filled ? Palette.bg : root.tone;
        font-size: 12px;
        font-weight: root.filled ? 700 : 400;
        vertical-alignment: center;
    }
    txt := Text { text: root.label; font-size: 12px; visible: false; }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { root.clicked(); }
    }
}

component TinyButton inherits Rectangle {
    in property <string> label;
    in property <color> tone: Palette.dim;
    callback clicked();
    border-color: touch.has-hover ? tone : Palette.line;
    border-width: 1px;
    border-radius: 4px;
    width: 22px;
    height: 18px;
    Text {
        text: root.label;
        color: root.tone;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One token: name, optional colour, bold/dim, and its move/remove controls.
component TokenLine inherits Rectangle {
    in property <TokenCell> cell;
    in property <[string]> allowed;
    in property <int> row-index;
    in property <int> index;
    callback act(string, int, int, int);
    callback set-token(int, int, string);
    callback set-flag(int, int, string, bool);
    callback open-fg(int, int);

    height: 36px;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        ComboBox {
            model: allowed;
            current-value: cell.token;
            width: 200px;
            selected(v) => { root.set-token(row-index, index, v); }
        }

        // fg: a checkbox to turn it on, plus the swatch it resolves to.
        CheckBox {
            checked: cell.has-fg;
            toggled => { root.set-flag(row-index, index, "fg-on", self.checked); }
        }
        Rectangle {
            width: 26px;
            height: 20px;
            border-radius: 4px;
            border-width: 1px;
            border-color: fgTouch.has-hover ? Palette.accent : Palette.line;
            background: cell.has-fg ? cell.fg : Palette.row;
            opacity: cell.has-fg ? 1.0 : 0.3;
            fgTouch := TouchArea {
                enabled: cell.has-fg;
                clicked => { root.open-fg(row-index, index); }
            }
        }

        CheckBox {
            text: "B";
            checked: cell.bold;
            toggled => { root.set-flag(row-index, index, "bold", self.checked); }
        }
        CheckBox {
            text: "D";
            checked: cell.dim;
            toggled => { root.set-flag(row-index, index, "dim", self.checked); }
        }

        TinyButton {
            label: "←";
            clicked => { root.act("move-token", row-index, index, -1); }
        }
        TinyButton {
            label: "→";
            clicked => { root.act("move-token", row-index, index, 1); }
        }
        TinyButton {
            label: "×";
            tone: Palette.red;
            clicked => { root.act("del-token", row-index, index, 0); }
        }
    }
}

// The rows editor: a card per line, a line per token.
component RowsEditor inherits VerticalLayout {
    in property <[RowEntry]> rows;
    in property <[string]> allowed;
    callback act(string, int, int, int);
    callback set-token(int, int, string);
    callback set-flag(int, int, string, bool);
    callback open-fg(int, int);

    spacing: 8px;

    for r[ri] in rows: Rectangle {
        background: #1e1e2e80;
        border-color: Palette.line;
        border-width: 1px;
        border-radius: 8px;
        height: card.preferred-height;

        card := VerticalLayout {
            spacing: 0px;

            Rectangle {
                height: 34px;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 10px;
                    Text {
                        text: (ri + 1) + " 行目";
                        color: Palette.accent;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Text {
                        text: r.preview;
                        color: Palette.dim;
                        font-family: "Menlo";
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    TinyButton {
                        label: "↑";
                        clicked => { root.act("move-row", ri, 0, -1); }
                    }
                    TinyButton {
                        label: "↓";
                        clicked => { root.act("move-row", ri, 0, 1); }
                    }
                    TinyButton {
                        label: "×";
                        tone: Palette.red;
                        clicked => { root.act("del-row", ri, 0, 0); }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Palette.line; }
            }

            for t[ti] in r.tokens: TokenLine {
                cell: t;
                allowed: root.allowed;
                row-index: ri;
                index: ti;
                act(a, rr, ii, d) => { root.act(a, rr, ii, d); }
                set-token(rr, ii, v) => { root.set-token(rr, ii, v); }
                set-flag(rr, ii, f, on) => { root.set-flag(rr, ii, f, on); }
                open-fg(rr, ii) => { root.open-fg(rr, ii); }
            }

            GhostButton {
                label: "＋ トークンを追加";
                tone: Palette.accent;
                clicked => { root.act("add-token", ri, 0, 0); }
            }
        }
    }

    GhostButton {
        label: "＋ 行を追加";
        tone: Palette.accent;
        clicked => { root.act("add-row", 0, 0, 0); }
    }
}

// Saturation / value square: a hue-coloured base with white fading in from
// the left and black fading in from the bottom, which is how an SV plane is
// built out of two linear gradients.
component SvPlane inherits Rectangle {
    in property <color> hue-color;
    in property <float> sat;
    in property <float> val;
    callback picked(float, float);

    background: hue-color;
    border-radius: 6px;
    clip: true;

    Rectangle {
        background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
    }
    Rectangle {
        background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
    }

    // The crosshair sits where the current colour is.
    Rectangle {
        x: root.sat * root.width - 6px;
        y: (1.0 - root.val) * root.height - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        border-width: 2px;
        border-color: #ffffff;
        background: transparent;
    }

    touch := TouchArea {
        clicked => { root.picked(touch.mouse-x / root.width, 1.0 - touch.mouse-y / root.height); }
        moved => {
            if (touch.pressed) {
                root.picked(touch.mouse-x / root.width, 1.0 - touch.mouse-y / root.height);
            }
        }
    }
}

component HueStrip inherits Rectangle {
    in property <float> hue;
    callback picked(float);

    height: 18px;
    border-radius: 5px;
    clip: true;
    background: @linear-gradient(90deg,
        #ff0000 0%, #ffff00 16.7%, #00ff00 33.3%,
        #00ffff 50%, #0000ff 66.7%, #ff00ff 83.3%, #ff0000 100%);

    Rectangle {
        x: root.hue * root.width - 2px;
        width: 4px;
        height: parent.height;
        border-radius: 2px;
        border-width: 1px;
        border-color: #ffffff;
        background: #00000040;
    }

    touch := TouchArea {
        clicked => { root.picked(touch.mouse-x / root.width); }
        moved => { if (touch.pressed) { root.picked(touch.mouse-x / root.width); } }
    }
}

// The picker itself, shown as a modal over the whole window.
component ColorPicker inherits Rectangle {
    in property <string> title;
    in property <color> hue-color;
    in property <color> current;
    in property <string> hex;
    in property <string> note;
    in property <float> hue;
    in property <float> sat;
    in property <float> val;
    in property <[color]> presets;
    in property <bool> allow-reset;
    callback pick-sv(float, float);
    callback pick-hue(float);
    callback set-hex(string);
    callback pick-preset(int);
    callback do-reset();
    callback close();

    background: #11111bb8;

    // Clicking the backdrop dismisses, so the panel swallows its own clicks.
    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: 340px;
        height: panel.preferred-height + 32px;
        background: Palette.panel;
        border-color: Palette.line;
        border-width: 1px;
        border-radius: 10px;
        TouchArea { }

        panel := VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: root.title;
                color: Palette.accent;
                font-family: "Menlo";
                font-size: 12px;
                font-weight: 600;
            }

            SvPlane {
                height: 150px;
                hue-color: root.hue-color;
                sat: root.sat;
                val: root.val;
                picked(s, v) => { root.pick-sv(s, v); }
            }

            HueStrip {
                hue: root.hue;
                picked(h) => { root.pick-hue(h); }
            }

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: 38px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Palette.line;
                    background: root.current;
                }
                LineEdit {
                    text: root.hex;
                    placeholder-text: "#89b4fa / cyan / rgb(1,2,3)";
                    edited(v) => { root.set-hex(v); }
                }
            }

            if root.note != "": Text {
                text: root.note;
                color: Palette.warn;
                font-size: 11px;
            }

            Text {
                text: "テーマの色";
                color: Palette.dim;
                font-size: 11px;
            }
            HorizontalLayout {
                spacing: 5px;
                for p[pi] in root.presets: Rectangle {
                    width: 22px;
                    height: 22px;
                    border-radius: 5px;
                    border-width: 1px;
                    border-color: pt.has-hover ? Palette.accent : Palette.line;
                    background: p;
                    pt := TouchArea { clicked => { root.pick-preset(pi); } }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                if root.allow-reset: GhostButton {
                    label: "reset にする";
                    tone: Palette.warn;
                    clicked => { root.do-reset(); }
                }
                Rectangle { }
                GhostButton {
                    label: "閉じる";
                    tone: Palette.accent;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// Attribution and licences. The Slint royalty-free licence asks for the
// `AboutSlint` widget in a screen reachable from the top-level menu.
component AboutPanel inherits Rectangle {
    callback close();

    background: #11111bb8;
    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: 480px;
        height: box.preferred-height + 32px;
        background: Palette.panel;
        border-color: Palette.line;
        border-width: 1px;
        border-radius: 10px;
        TouchArea { }

        box := VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                Text {
                    text: "herdr Config 0.1.0";
                    color: Palette.text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { }
                GhostButton {
                    label: "閉じる";
                    tone: Palette.accent;
                    clicked => { root.close(); }
                }
            }

            Text {
                text: "herdr の config.toml を編集する GUI";
                color: Palette.dim;
                font-size: 12px;
            }
            Text {
                text: "Copyright (c) 2026 Members Co., Ltd\nAll rights reserved.\nBSD-3-Clause";
                color: Palette.dim;
                font-family: "Menlo";
                font-size: 11px;
            }

            Rectangle { height: 1px; background: Palette.line; }

            // Left to itself this fills whatever space it is given, so the
            // logo has to be boxed.
            //
            // `AboutSlint` opens slint.dev when clicked but sets no cursor,
            // so a transparent layer on top supplies the affordance and opens
            // the same URL. The widget itself is still what is displayed,
            // which is what the royalty-free licence asks for.
            Rectangle {
                height: 140px;
                border-radius: 8px;
                border-width: 1px;
                border-color: logoTouch.has-hover ? Palette.line : transparent;
                background: logoTouch.has-hover ? #ffffff0a : transparent;

                HorizontalLayout {
                    alignment: center;
                    AboutSlint {
                        height: 140px;
                        width: 380px;
                    }
                }

                logoTouch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { Platform.open-url("https://slint.dev"); }
                }
            }
            Text {
                text: logoTouch.has-hover
                    ? "クリックで slint.dev を開きます"
                    : "UI は Slint（Royalty-free 2.0）を使用しています。";
                color: logoTouch.has-hover ? Palette.accent : Palette.faint;
                font-size: 10px;
                horizontal-alignment: center;
            }
        }
    }
}

// What a save would write, checked through herdr before anything is written.
component DiffPanel inherits Rectangle {
    in property <[DiffRow]> rows;
    in property <string> check;
    in property <bool> check-ok;
    in property <bool> fatal;
    in property <string> after;
    callback save();
    callback close();

    background: #11111bb8;
    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(860px, parent.width - 32px);
        height: min(parent.height - 60px, 760px);
        background: Palette.panel;
        border-color: Palette.line;
        border-width: 1px;
        border-radius: 10px;
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "保存される差分";
                    color: Palette.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Chip {
                    label: root.rows.length + " 件";
                    tone: Palette.accent;
                }
                Rectangle { }
                GhostButton {
                    label: "閉じる";
                    clicked => { root.close(); }
                }
                GhostButton {
                    label: "保存して反映";
                    tone: Palette.accent;
                    filled: true;
                    enabled: !root.fatal;
                    clicked => { root.save(); }
                }
            }

            // herdr's verdict on the exact bytes that would be written.
            Rectangle {
                height: verdict.preferred-height + 16px;
                border-radius: 6px;
                background: Palette.row;
                border-width: 1px;
                border-color: root.fatal ? Palette.red
                    : root.check-ok ? Palette.set : Palette.warn;
                verdict := VerticalLayout {
                    x: 12px;
                    y: 8px;
                    width: parent.width - 24px;
                    Text {
                        text: root.fatal
                            ? "この内容では herdr が設定ファイル全体を破棄します。保存できません。"
                            : root.check-ok
                                ? "herdr config check: 問題なし"
                                : "herdr が無視する項目があります（他の設定は有効です）";
                        color: root.fatal ? Palette.red
                            : root.check-ok ? Palette.set : Palette.warn;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.check != "": Text {
                        text: root.check;
                        color: Palette.dim;
                        font-family: "Menlo";
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }

            ScrollView {
                VerticalLayout {
                    spacing: 3px;
                    alignment: start;
                    for d in root.rows: Rectangle {
                        height: 26px;
                        border-radius: 5px;
                        background: Palette.row;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Text {
                                text: d.action;
                                color: d.action == "add" ? Palette.set
                                    : d.action == "remove" ? Palette.red : Palette.accent;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                                width: 56px;
                            }
                            Text {
                                text: d.path;
                                color: Palette.text;
                                font-family: "Menlo";
                                font-size: 11px;
                                vertical-alignment: center;
                                min-width: 0px;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: d.from;
                                color: Palette.dim;
                                font-family: "Menlo";
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: "→";
                                color: Palette.faint;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: d.to;
                                color: Palette.accent;
                                font-family: "Menlo";
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    Text {
                        text: "保存後のファイル内容";
                        color: Palette.dim;
                        font-size: 11px;
                    }
                    Rectangle {
                        background: Palette.bg;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Palette.line;
                        height: body.preferred-height + 16px;
                        body := Text {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 24px;
                            text: root.after;
                            color: Palette.dim;
                            font-family: "Menlo";
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}

// Everything wrong with the current keybindings, and what to do about each.
component ProblemsPanel inherits Rectangle {
    in property <[ProblemRow]> rows;
    in property <int> errors;
    in property <int> warnings;
    callback goto(string);
    callback record(string);
    callback disable(string);
    callback close();

    background: #11111bb8;
    TouchArea { clicked => { root.close(); } }

    Rectangle {
        width: min(820px, parent.width - 32px);
        height: min(parent.height - 60px, 720px);
        background: Palette.panel;
        border-color: Palette.line;
        border-width: 1px;
        border-radius: 10px;
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "キー設定の問題";
                    color: Palette.text;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.errors > 0: Chip { label: "エラー " + root.errors; tone: Palette.red; }
                if root.warnings > 0: Chip { label: "警告 " + root.warnings; tone: Palette.warn; }
                if root.errors == 0 && root.warnings == 0: Chip { label: "問題なし"; tone: Palette.set; }
                Rectangle { }
                GhostButton {
                    label: "閉じる";
                    tone: Palette.accent;
                    clicked => { root.close(); }
                }
            }

            if root.rows.length == 0: Text {
                text: "キー設定に問題はありません。\n構文エラー・重複したキー・端末が届けにくいキーが見つかるとここに並びます。";
                color: Palette.dim;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }

            ScrollView {
                VerticalLayout {
                    spacing: 10px;
                    alignment: start;
                    for p in root.rows: Rectangle {
                        background: #1e1e2e80;
                        border-color: Palette.line;
                        border-width: 1px;
                        border-radius: 7px;
                        height: card.preferred-height + 16px;

                        Rectangle {
                            x: 0;
                            width: 3px;
                            background: p.severity == "error" ? Palette.red : Palette.warn;
                        }

                        card := VerticalLayout {
                            x: 12px;
                            y: 8px;
                            width: parent.width - 20px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Chip {
                                    label: p.label;
                                    tone: p.severity == "error" ? Palette.red : Palette.warn;
                                }
                                Text {
                                    text: p.chord == "" ? "\"\"" : p.chord;
                                    color: Palette.accent;
                                    font-family: "Menlo";
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if p.scope == "navigate": Text {
                                    text: "navigate モード内";
                                    color: Palette.dim;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: p.detail;
                                    color: Palette.text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            Text {
                                text: p.advice;
                                color: Palette.dim;
                                font-size: 11px;
                                wrap: word-wrap;
                                width: parent.width;
                            }

                            for e in p.entries: HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: e.path;
                                    color: Palette.text;
                                    font-family: "Menlo";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: e.value == "" ? "\"\"" : e.value;
                                    color: Palette.dim;
                                    font-family: "Menlo";
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: e.state;
                                    color: Palette.faint;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                Rectangle { }
                                GhostButton {
                                    label: "この設定へ移動";
                                    clicked => { root.goto(e.path); }
                                }
                                GhostButton {
                                    label: "キーを録音";
                                    tone: Palette.accent;
                                    clicked => { root.record(e.path); }
                                }
                                GhostButton {
                                    label: "無効にする";
                                    tone: Palette.warn;
                                    clicked => { root.disable(e.path); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Key capture. Two phases, because Esc and Enter are themselves bindable:
// while recording every keypress is swallowed and turned into a chord; once
// captured, Esc cancels and Enter confirms.
component KeyCapture inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <string> chord;
    in property <string> note;
    in property <string> level;
    in property <bool> recording;
    callback pressed(string, bool, bool, bool, bool);
    callback again();
    callback confirm();
    callback cancel();
    callback clear();

    background: #11111bb8;
    TouchArea { clicked => { root.cancel(); } }

    // Names the platform-specific codepoints here so Rust never sees them.
    function name-of(t: string) -> string {
        return t == Key.Escape ? "esc"
            : t == Key.Return ? "enter"
            : t == Key.Tab ? "tab"
            : t == Key.Backspace ? "backspace"
            : t == Key.Delete ? "delete"
            : t == Key.Space ? "space"
            : t == Key.UpArrow ? "up"
            : t == Key.DownArrow ? "down"
            : t == Key.LeftArrow ? "left"
            : t == Key.RightArrow ? "right"
            : t == Key.Home ? "home"
            : t == Key.End ? "end"
            : t == Key.PageUp ? "pageup"
            : t == Key.PageDown ? "pagedown"
            : t == Key.Shift || t == Key.ShiftR ? "shift"
            : t == Key.Control || t == Key.ControlR ? "ctrl"
            : t == Key.Alt ? "alt"
            : t == Key.Meta || t == Key.MetaR ? "cmd"
            : t == Key.CapsLock ? "caps"
            : t == Key.F1 ? "f1" : t == Key.F2 ? "f2" : t == Key.F3 ? "f3"
            : t == Key.F4 ? "f4" : t == Key.F5 ? "f5" : t == Key.F6 ? "f6"
            : t == Key.F7 ? "f7" : t == Key.F8 ? "f8" : t == Key.F9 ? "f9"
            : t == Key.F10 ? "f10" : t == Key.F11 ? "f11" : t == Key.F12 ? "f12"
            : t;
    }

    Rectangle {
        width: 420px;
        height: box.preferred-height + 32px;
        background: Palette.panel;
        border-color: Palette.line;
        border-width: 1px;
        border-radius: 10px;
        TouchArea { }

        fs := FocusScope {
            key-pressed(e) => {
                root.pressed(name-of(e.text), e.modifiers.control, e.modifiers.shift,
                             e.modifiers.alt, e.modifiers.meta);
                return accept;
            }
        }

        box := VerticalLayout {
            padding: 16px;
            spacing: 10px;

            Text {
                text: root.title;
                color: Palette.accent;
                font-family: "Menlo";
                font-size: 12px;
                font-weight: 600;
            }
            Text {
                text: root.hint;
                color: Palette.dim;
                font-size: 12px;
                wrap: word-wrap;
            }

            // The phase has to be unmissable: once a chord is captured the
            // modal stops listening, and a stale chord looks like a wrong one.
            Rectangle {
                height: 22px;
                border-radius: 11px;
                background: root.recording ? Palette.red : Palette.line;
                HorizontalLayout {
                    alignment: center;
                    Text {
                        text: root.recording ? "● 録音中 — 次の打鍵を待っています"
                                             : "■ 録音停止中 — 変更するには「もう一度録音」";
                        color: root.recording ? #11111b : Palette.text;
                        font-size: 11px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 66px;
                border-radius: 8px;
                background: Palette.row;
                border-width: root.recording ? 1px : 2px;
                border-color: root.level == "err" ? Palette.red
                    : root.level == "risky" ? #fab387
                    : root.level == "caution" ? Palette.warn
                    : root.level == "safe" ? Palette.set
                    : Palette.faint;
                Text {
                    text: root.chord == "" ? "キー入力待ち…" : root.chord;
                    color: root.chord == "" ? Palette.dim : Palette.text;
                    font-family: "Menlo";
                    font-size: root.chord == "" ? 14px : 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.note != "": Text {
                text: root.note;
                color: root.level == "err" ? Palette.red : Palette.dim;
                font-size: 11px;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;
                GhostButton {
                    label: "もう一度録音";
                    clicked => { root.again(); }
                }
                GhostButton {
                    label: "無効にする";
                    tone: Palette.warn;
                    clicked => { root.clear(); }
                }
                Rectangle { }
                GhostButton {
                    label: "キャンセル";
                    clicked => { root.cancel(); }
                }
                GhostButton {
                    label: "確定";
                    tone: Palette.accent;
                    clicked => { root.confirm(); }
                }
            }
        }
        init => { fs.focus(); }
    }
}

// One setting. The 3px bar on the left is the state marker.
component SettingRow inherits Rectangle {
    in property <ItemRow> item;
    in property <[string]> allowed;
    callback edited(string, string);
    callback swatch-clicked(string);
    callback rows-act(string, string, int, int, int);
    callback rows-set-token(string, int, int, string);
    callback rows-set-flag(string, int, int, string, bool);
    callback rows-open-fg(string, int, int);
    callback record(string);
    callback revert-one(string);
    callback disable-one(string);

    height: layout.preferred-height + 16px;
    background: item.is-dirty ? #89b4fa14 : transparent;

    Rectangle {
        x: 0;
        width: 3px;
        border-radius: 2px;
        background: item.is-dirty ? Palette.accent
            : item.is-set ? Palette.set : transparent;
    }

    layout := VerticalLayout {
        x: 12px;
        y: 8px;
        width: parent.width - 20px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            Text {
                // While filtering, hits come from every section, so the key
                // alone would not say where each one lives.
                text: item.label;
                color: Palette.text;
                font-family: "Menlo";
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                min-width: 110px;
                max-width: 220px;
                horizontal-stretch: 1;
                overflow: elide;
            }

            if item.from-overlay: Chip {
                label: "未文書";
                tone: #cba6f7;
            }

            Chip {
                label: item.state-label;
                tone: item.is-dirty ? Palette.accent
                    : item.state-label == "無効" ? Palette.warn
                    : item.is-set ? Palette.set : Palette.dim;
            }

            if item.kind == "color": Rectangle {
                width: 34px;
                height: 24px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.line;
                background: item.has-swatch ? item.swatch : Palette.row;
                TouchArea { clicked => { root.swatch-clicked(item.path); } }
            }

            if item.kind == "bool": ComboBox {
                model: ["既定 (" + item.default-text + ")", "true", "false"];
                current-value: item.value == "" ? "既定 (" + item.default-text + ")" : item.value;
                width: 190px;
                selected(v) => { root.edited(item.path, v == "true" || v == "false" ? v : ""); }
            }

            if item.kind == "rows": Text {
                text: item.rows.length + " 行";
                color: Palette.set;
                font-size: 11px;
                vertical-alignment: center;
                width: 240px;
            }

            if item.enum-strict && item.kind != "bool": ComboBox {
                model: item.enum-values;
                current-value: item.value;
                min-width: 160px;
                max-width: 260px;
                horizontal-stretch: 1;
                selected(v) => { root.edited(item.path, v); }
            }

            if !item.enum-strict && item.kind != "bool" && item.kind != "rows": LineEdit {
                text: item.value;
                placeholder-text: item.default-text == "" ? "(未設定)" : item.default-text;
                min-width: 160px;
                max-width: 260px;
                horizontal-stretch: 1;
                edited(v) => { root.edited(item.path, v); }
            }

            if item.is-binding: GhostButton {
                label: "キーを録音";
                tone: Palette.accent;
                clicked => { root.record(item.path); }
            }

            if item.is-set: GhostButton {
                label: "既定に戻す";
                clicked => { root.revert-one(item.path); }
            }

            if item.empty-disables && item.state-label != "無効": GhostButton {
                label: "無効にする";
                tone: Palette.warn;
                clicked => { root.disable-one(item.path); }
            }

            // Last in the row and the least important, so this is what
            // gives way when the pane is narrow.
            Text {
                text: "既定 " + item.default-text;
                color: Palette.faint;
                font-size: 11px;
                font-family: "Menlo";
                vertical-alignment: center;
                min-width: 0px;
                horizontal-stretch: 2;
                overflow: elide;
            }
        }

        if item.key-note != "": HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Chip {
                label: item.key-level == "safe" ? "安定"
                    : item.key-level == "caution" ? "要確認"
                    : item.key-level == "risky" ? "端末依存" : "エラー";
                tone: item.key-level == "safe" ? Palette.set
                    : item.key-level == "caution" ? Palette.warn
                    : item.key-level == "risky" ? #fab387 : Palette.red;
            }
            Text {
                text: item.key-note;
                color: item.key-level == "err" ? Palette.red : Palette.dim;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if item.doc != "": Text {
            text: item.doc;
            color: Palette.dim;
            font-size: 12px;
            wrap: word-wrap;
            width: parent.width;
        }

        if item.kind == "rows": RowsEditor {
            rows: item.rows;
            allowed: root.allowed;
            act(a, r, i, d) => { root.rows-act(item.path, a, r, i, d); }
            set-token(r, i, v) => { root.rows-set-token(item.path, r, i, v); }
            set-flag(r, i, f, on) => { root.rows-set-flag(item.path, r, i, f, on); }
            open-fg(r, i) => { root.rows-open-fg(item.path, r, i); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.line;
    }
}

export component App inherits Window {
    title: "herdr Config (Slint 試作)";
    preferred-width: 1180px;
    preferred-height: 820px;
    background: Palette.bg;

    in property <[SectionRow]> sections;
    in property <[ItemRow]> items;
    in property <string> meta;
    in property <string> section-title;
    in property <string> filter;
    in-out property <length> sidebar-width: 250px;
    in property <int> selected: 0;
    in property <int> dirty-count: 0;
    in property <string> result;
    in property <bool> about-open: false;
    in property <[string]> allowed-tokens;
    in property <bool> picker-open: false;
    in property <string> picker-title;
    in property <color> picker-hue-color;
    in property <color> picker-current;
    in property <string> picker-hex;
    in property <string> picker-note;
    in property <float> picker-hue;
    in property <float> picker-sat;
    in property <float> picker-val;
    in property <[color]> picker-presets;
    in property <bool> picker-allow-reset;
    in property <bool> capture-open: false;
    in property <string> capture-title;
    in property <string> capture-hint;
    in property <string> capture-chord;
    in property <string> capture-note;
    in property <string> capture-level;
    in property <bool> capture-recording: true;
    in property <[ProblemRow]> problems;
    in property <int> problem-errors;
    in property <int> problem-warnings;
    in property <bool> problems-open: false;
    in property <bool> diff-open: false;
    in property <[DiffRow]> diff-rows;
    in property <string> diff-check;
    in property <bool> diff-check-ok;
    in property <bool> diff-fatal;
    in property <string> diff-after;
    // An array-of-tables section is a list of entries, not a set of settings.
    in property <bool> section-is-list: false;
    in property <[EntryCard]> entries;

    callback picker-pick-sv(float, float);
    callback picker-pick-hue(float);
    callback picker-set-hex(string);
    callback picker-preset(int);
    callback picker-reset();
    callback picker-close();
    // Clamping lives in Rust so it can be tested.
    callback resize-sidebar(length);
    callback reset-sidebar();
    callback filter-changed(string);
    callback open-problems();
    callback close-problems();
    callback close-diff();
    callback problem-goto(string);
    callback add-entry();
    callback remove-entry(int);
    callback select-section(int);
    callback edited(string, string);
    callback swatch-clicked(string);
    callback rows-act(string, string, int, int, int);
    callback rows-set-token(string, int, int, string);
    callback rows-set-flag(string, int, int, string, bool);
    callback rows-open-fg(string, int, int);
    callback record(string);
    callback revert-one(string);
    callback disable-one(string);
    callback capture-pressed(string, bool, bool, bool, bool);
    callback capture-again();
    callback capture-confirm();
    callback capture-cancel();
    callback capture-clear();
    callback preview();
    callback save();
    callback revert();
    callback toggle-about();
    callback close-about();

    VerticalLayout {
        // ---- top bar ----
        Rectangle {
            height: 44px;
            background: Palette.panel;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                Text {
                    text: "herdr Config";
                    color: Palette.text;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                LineEdit {
                    placeholder-text: "設定を検索（キー名・説明文）";
                    text: root.filter;
                    width: 250px;
                    edited(v) => { root.filter-changed(v); }
                }
                Text {
                    text: meta;
                    color: Palette.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Palette.line; }
        }

        HorizontalLayout {
            // ---- sidebar ----
            Rectangle {
                width: root.sidebar-width;
                background: Palette.panel;
                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 1px;
                        alignment: start;
                        for s[i] in sections: Rectangle {
                            height: 28px;
                            border-radius: 5px;
                            background: i == selected ? Palette.line
                                : rowTouch.has-hover ? Palette.row : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                Text {
                                    text: s.name == "" ? "(root)" : s.name;
                                    color: i == selected ? Palette.accent : Palette.text;
                                    font-family: "Menlo";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: s.set-count > 0 ? s.set-count + "/" + s.total : s.total;
                                    color: s.set-count > 0 ? Palette.set : Palette.faint;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                }
                            }
                            rowTouch := TouchArea { clicked => { select-section(i); } }
                        }
                    }
                }
            }

            // Drag handle: a wide hit area drawing a thin line, so section
            // names longer than the default width stay reachable.
            Rectangle {
                width: 7px;
                Rectangle {
                    x: 3px;
                    width: split.has-hover || split.pressed ? 2px : 1px;
                    height: parent.height;
                    background: split.has-hover || split.pressed ? Palette.accent : Palette.line;
                }
                split := TouchArea {
                    mouse-cursor: MouseCursor.col-resize;
                    moved => {
                        // The handle moves with the sidebar, so each step is
                        // the offset from where the press landed.
                        root.resize-sidebar(self.mouse-x - self.pressed-x);
                    }
                    double-clicked => { root.reset-sidebar(); }
                }
            }

            // ---- items ----
            ScrollView {
                VerticalLayout {
                    padding: 14px;
                    spacing: 0px;
                    alignment: start;
                    Text {
                        text: section-title;
                        color: Palette.accent;
                        font-family: "Menlo";
                        font-size: 14px;
                    }
                    if section-is-list: VerticalLayout {
                        spacing: 10px;
                        for e in entries: Rectangle {
                            background: #1e1e2e80;
                            border-color: Palette.line;
                            border-width: 1px;
                            border-radius: 8px;
                            height: entry.preferred-height;

                            entry := VerticalLayout {
                                Rectangle {
                                    height: 38px;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        Text {
                                            text: "#" + (e.index + 1);
                                            color: Palette.accent;
                                            font-size: 11px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: e.label;
                                            color: Palette.text;
                                            font-family: "Menlo";
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle { }
                                        GhostButton {
                                            label: "このエントリを削除";
                                            tone: Palette.red;
                                            clicked => { root.remove-entry(e.index); }
                                        }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Palette.line; }
                                }
                                for it in e.items: SettingRow {
                                    item: it;
                                    allowed: root.allowed-tokens;
                                    edited(p, v) => { root.edited(p, v); }
                                    swatch-clicked(p) => { root.swatch-clicked(p); }
                                    rows-act(p, a, r, i, d) => { root.rows-act(p, a, r, i, d); }
                                    rows-set-token(p, r, i, v) => { root.rows-set-token(p, r, i, v); }
                                    rows-set-flag(p, r, i, f, on) => { root.rows-set-flag(p, r, i, f, on); }
                                    rows-open-fg(p, r, i) => { root.rows-open-fg(p, r, i); }
                                    record(p) => { root.record(p); }
                                    revert-one(p) => { root.revert-one(p); }
                                    disable-one(p) => { root.disable-one(p); }
                                }
                            }
                        }
                        GhostButton {
                            label: "＋ エントリを追加";
                            tone: Palette.accent;
                            clicked => { root.add-entry(); }
                        }
                    }

                    if !section-is-list: VerticalLayout {
                        spacing: 0px;
                        alignment: start;
                        for it in items: SettingRow {
                        item: it;
                        allowed: root.allowed-tokens;
                        edited(p, v) => { root.edited(p, v); }
                        swatch-clicked(p) => { root.swatch-clicked(p); }
                        rows-act(p, a, r, i, d) => { root.rows-act(p, a, r, i, d); }
                        rows-set-token(p, r, i, v) => { root.rows-set-token(p, r, i, v); }
                        rows-set-flag(p, r, i, f, on) => { root.rows-set-flag(p, r, i, f, on); }
                        rows-open-fg(p, r, i) => { root.rows-open-fg(p, r, i); }
                        record(p) => { root.record(p); }
                        revert-one(p) => { root.revert-one(p); }
                        disable-one(p) => { root.disable-one(p); }
                        }
                    }
                }
            }
        }

        // ---- save bar ----
        Rectangle {
            height: 52px;
            background: Palette.panel;
            // Without an explicit y this lands over the controls instead of
            // on the boundary with the content above.
            Rectangle { y: 0; height: 1px; background: Palette.line; }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                // Leaves exactly the buttons' own height, so every control in
                // the row shares one baseline.
                padding-top: 12px;
                padding-bottom: 12px;
                // 52 = 12 + 28 + 12
                spacing: 10px;

                TextLink {
                    label: "About";
                    clicked => { toggle-about(); }
                }

                // The report takes whatever room is left, so the controls sit
                // against the right edge of the window.
                Text {
                    text: result;
                    color: Palette.dim;
                    font-size: 11px;
                    vertical-alignment: center;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                // Two different questions, kept side by side rather than in
                // opposite corners: whether the saved config has a problem,
                // and whether there is anything not yet saved.
                GhostButton {
                    label: problem-errors + problem-warnings > 0
                        ? "キー設定の問題 " + (problem-errors + problem-warnings)
                        : "キー設定の問題 なし";
                    tone: problem-errors > 0 ? Palette.red
                        : problem-warnings > 0 ? Palette.warn : Palette.dim;
                    clicked => { open-problems(); }
                }

                GhostButton {
                    label: "すべて取り消し";
                    enabled: dirty-count > 0;
                    clicked => { revert(); }
                }
                GhostButton {
                    label: "差分を確認";
                    enabled: dirty-count > 0;
                    clicked => { preview(); }
                }
                GhostButton {
                    label: "保存して反映";
                    tone: Palette.accent;
                    filled: true;
                    enabled: dirty-count > 0;
                    clicked => { save(); }
                }
            }
        }
    }

    if about-open: AboutPanel {
        close() => { root.close-about(); }
    }

    if diff-open: DiffPanel {
        rows: diff-rows;
        check: diff-check;
        check-ok: diff-check-ok;
        fatal: diff-fatal;
        after: diff-after;
        save() => { root.save(); }
        close() => { root.close-diff(); }
    }

    if problems-open: ProblemsPanel {
        rows: problems;
        errors: problem-errors;
        warnings: problem-warnings;
        goto(p) => { root.problem-goto(p); }
        record(p) => { root.record(p); }
        disable(p) => { root.disable-one(p); }
        close() => { root.close-problems(); }
    }

    if capture-open: KeyCapture {
        title: capture-title;
        hint: capture-hint;
        chord: capture-chord;
        note: capture-note;
        level: capture-level;
        recording: capture-recording;
        pressed(k, c, s, a, m) => { root.capture-pressed(k, c, s, a, m); }
        again() => { root.capture-again(); }
        confirm() => { root.capture-confirm(); }
        cancel() => { root.capture-cancel(); }
        clear() => { root.capture-clear(); }
    }

    // Painted last so it covers the whole window.
    if picker-open: ColorPicker {
        title: picker-title;
        hue-color: picker-hue-color;
        current: picker-current;
        hex: picker-hex;
        note: picker-note;
        hue: picker-hue;
        sat: picker-sat;
        val: picker-val;
        presets: picker-presets;
        allow-reset: picker-allow-reset;
        pick-sv(sv, vv) => { root.picker-pick-sv(sv, vv); }
        pick-hue(h) => { root.picker-pick-hue(h); }
        set-hex(v) => { root.picker-set-hex(v); }
        pick-preset(i) => { root.picker-preset(i); }
        do-reset() => { root.picker-reset(); }
        close() => { root.picker-close(); }
    }
}
